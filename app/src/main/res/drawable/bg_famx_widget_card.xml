<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Dark Obsidian Card Body -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="135"
                android:startColor="#182A21"
                android:centerColor="#0B151C"
                android:endColor="#04080D"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top Neon Matrix Cyber-Line Highlight -->
    <item android:top="0dp" android:bottom="170dp" android:left="30dp" android:right="30dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <gradient
                android:angle="0"
                android:startColor="#0000E676"
                android:centerColor="#CC00E676"
                android:endColor="#0000E676"
                android:type="linear" />
        </shape>
    </item>

    <!-- Glowing Outer Cyber Matrix Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="2dp"
                android:color="#8000E676" />
        </shape>
    </item>
</layer-list>
