<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Bottom 3D Depth Shadow Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#04070A" />
        </shape>
    </item>

    <!-- 2. Main Raised 3D Card Surface -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#182330"
                android:centerColor="#0E1620"
                android:endColor="#090E15"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#405A78" />
        </shape>
    </item>

    <!-- 3. Bottom Soft Green Glow Accent (Subtle, non-intrusive) -->
    <item android:top="60dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="22dp" android:bottomRightRadius="22dp" />
            <gradient
                android:angle="90"
                android:startColor="#3000E676"
                android:endColor="#0000E676"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
