<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom 3D Depth Base Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#003D1E" />
        </shape>
    </item>
    <!-- Top 3D Raised Beveled Surface -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#00FF88"
                android:centerColor="#00E676"
                android:endColor="#00A34D"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#E6FFFFFF" />
        </shape>
    </item>
</layer-list>
